# Dependencies
node_modules/

# Build output — regenerated by `npm run build` / the `prepare` script on git install.
# DSH's git-install flow runs `prepare`, so built lib/ is NOT committed.
lib/
*.tsbuildinfo

# Test / coverage
coverage/
.vitest/

# Secrets and local env — NEVER commit
.env
.env.*
*.key
*-api-key*
secrets.*

# Local thesis data — NEVER commit real student/teacher content
*.docx
*.doc
*.sqlite
*.sqlite3
*.db
*.port
artifacts/
out/
demo-out/

# Local absolute-path config / editor / OS cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
